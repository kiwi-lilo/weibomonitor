  <div style="border:1px solid #e3e3e3;border-radius:8px;overflow:hidden;margin-bottom:18px;">
    <div style="background:{{ '#e74c3c' if new_negatives else '#2ecc71' }};color:#fff;padding:14px 18px;">
      <span style="font-size:17px;font-weight:bold;">{{ city_name }}</span>
      <span style="float:right;font-size:13px;opacity:.9;">
        新增 {{ new_negatives|length }} ｜ 总量 {{ results|length }}
      </span>
    </div>
    <div style="background:#fff;padding:14px 18px;">

      <table width="100%" cellpadding="0" cellspacing="0" style="text-align:center;font-size:12px;color:#666;">
        <tr>
          <td><div style="font-size:20px;font-weight:bold;color:#e74c3c;">{{ new_negatives|length }}</div>新增负面/关注</td>
          <td><div style="font-size:20px;font-weight:bold;color:#333;">{{ results|length }}</div>个人微博</td>
          <td><div style="font-size:20px;font-weight:bold;color:#95a5a6;">{{ old_negative_count }}</div>历史重复</td>
          <td><div style="font-size:20px;font-weight:bold;color:#95a5a6;">{{ filtered_count }}</div>过滤官方号</td>
        </tr>
      </table>

      <div style="margin-top:12px;padding:8px 10px;border-radius:6px;font-size:12px;
                  background:{{ '#fdecea' if not health_ok else '#eafaf1' }};
                  color:{{ '#c0392b' if not health_ok else '#1e8449' }};">
        采集健康度：{{ health_summary }}{% if not health_ok %} <b>（数据可能不完整）</b>{% endif %}
      </div>

      {% if new_negatives %}
      <div style="margin:16px 0 8px;font-weight:bold;font-size:14px;border-left:4px solid #e74c3c;padding-left:8px;">🔴 新增负面详情</div>
      {% for w in new_negatives %}
      <div style="border:1px solid #eee;border-radius:6px;padding:10px;margin-bottom:8px;font-size:13px;">
        <div style="margin-bottom:5px;">
          <span style="background:{{ label_colors.get(w.sentiment_label,'#95a5a6') }};color:#fff;padding:2px 7px;border-radius:3px;font-size:11px;">{{ w.sentiment_label }}</span>
          <b style="margin-left:5px;">{{ w.user }}</b>
          <span style="color:#999;">（{{ w.user_type }}，粉丝 {{ w.followers }}）</span>
          <span style="float:right;color:#999;">{{ w.time }}</span>
        </div>
        <div style="color:#333;line-height:1.6;">{{ w.text[:400] }}{% if w.text|length > 400 %}…{% endif %}</div>
        <div style="margin-top:6px;color:#888;font-size:12px;">
          📍{{ w.regions|join('、') }} ｜ 🔥{{ w.heat }}（转{{ w.reposts }}/评{{ w.comments }}/赞{{ w.likes }}）
          {% if w.strong_neg %}｜强负面：{{ w.strong_neg|join('、') }}{% endif %}
          {% if w.model_score is not none %}｜🧠{{ '%.0f'|format(w.model_score*100) }}%{% endif %}
          {% if w.llm_reason %}｜🤖{{ w.llm_reason }}{% endif %}
        </div>
        <div style="margin-top:4px;"><a href="{{ w.url }}" style="color:#3498db;font-size:12px;">查看原微博 →</a></div>
      </div>
      {% endfor %}
      {% else %}
      <p style="color:#2ecc71;text-align:center;padding:12px 0;font-size:14px;">✅ 未发现新增的个人负面舆情</p>
      {% endif %}

      {% if region_stats %}
      <div style="margin:16px 0 6px;font-weight:bold;font-size:13px;border-left:4px solid #3498db;padding-left:8px;">📍 区县分布</div>
      <table width="100%" cellpadding="5" cellspacing="0" style="font-size:12px;border-collapse:collapse;">
        <tr style="background:#f8f9fa;color:#666;"><th align="left">区县</th><th>总量</th><th>负面</th><th>占比</th></tr>
        {% for r in region_stats %}
        <tr style="border-bottom:1px solid #f0f0f0;">
          <td>{{ r.name }}</td><td align="center">{{ r.total }}</td>
          <td align="center" style="color:{{ r.color }};font-weight:bold;">{{ r.neg }}</td>
          <td align="center">{{ '%.1f'|format(r.ratio) }}%</td>
        </tr>
        {% endfor %}
      </table>
      {% endif %}
    </div>
  </div>
