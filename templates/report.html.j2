<!DOCTYPE html>
<html lang="zh-CN">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:'PingFang SC','Microsoft YaHei',sans-serif;">
<div style="max-width:720px;margin:0 auto;padding:16px;">

  <div style="background:{{ '#e74c3c' if new_negatives else '#2ecc71' }};color:#fff;border-radius:8px 8px 0 0;padding:18px 20px;">
    <div style="font-size:19px;font-weight:bold;">{{ city_name }}微博舆情日报</div>
    <div style="font-size:13px;opacity:.9;margin-top:4px;">
      监测区间 {{ period }} ｜ 生成于 {{ generated_at }}
    </div>
  </div>

  <div style="background:#fff;padding:16px 20px;border-radius:0 0 8px 8px;">

    <!-- 概览 -->
    <table width="100%" cellpadding="0" cellspacing="0" style="text-align:center;font-size:13px;color:#555;">
      <tr>
        <td><div style="font-size:22px;font-weight:bold;color:#e74c3c;">{{ new_negatives|length }}</div>新增负面/关注</td>
        <td><div style="font-size:22px;font-weight:bold;color:#333;">{{ results|length }}</div>个人微博总量</td>
        <td><div style="font-size:22px;font-weight:bold;color:#95a5a6;">{{ old_negative_count }}</div>历史重复负面</td>
        <td><div style="font-size:22px;font-weight:bold;color:#95a5a6;">{{ filtered_count }}</div>已过滤官方号</td>
      </tr>
    </table>

    <!-- 采集健康度 -->
    <div style="margin-top:14px;padding:10px 12px;border-radius:6px;font-size:13px;
                background:{{ '#fdecea' if not health_ok else '#eafaf1' }};
                color:{{ '#c0392b' if not health_ok else '#1e8449' }};">
      采集健康度：{{ health_summary }}
      {% if not health_ok %}<b>（数据可能不完整，本报告结论仅供参考）</b>{% endif %}
    </div>

    {% if new_negatives %}
    <h3 style="border-left:4px solid #e74c3c;padding-left:8px;margin:22px 0 10px;font-size:15px;">🔴 新增负面详情（{{ new_negatives|length }} 条）</h3>
    {% for w in new_negatives %}
    <div style="border:1px solid #eee;border-radius:6px;padding:12px;margin-bottom:10px;font-size:13px;">
      <div style="margin-bottom:6px;">
        <span style="background:{{ label_colors.get(w.sentiment_label,'#95a5a6') }};color:#fff;padding:2px 8px;border-radius:3px;font-size:12px;">{{ w.sentiment_label }}</span>
        <b style="margin-left:6px;">{{ w.user }}</b>
        <span style="color:#999;">（{{ w.user_type }}，粉丝 {{ w.followers }}）</span>
        <span style="float:right;color:#999;">{{ w.time }}</span>
      </div>
      <div style="color:#333;line-height:1.6;">{{ w.text[:400] }}{% if w.text|length > 400 %}…{% endif %}</div>
      <div style="margin-top:8px;color:#888;font-size:12px;">
        📍{{ w.regions|join('、') }} ｜ 🔥热度 {{ w.heat }}（转{{ w.reposts }}/评{{ w.comments }}/赞{{ w.likes }}）
        {% if w.strong_neg %}｜ 强负面：{{ w.strong_neg|join('、') }}{% endif %}
        {% if w.medium_neg %}｜ 中负面：{{ w.medium_neg|join('、') }}{% endif %}
        {% if w.llm_reason %}｜ 🤖{{ w.llm_reason }}{% endif %}
      </div>
      <div style="margin-top:6px;"><a href="{{ w.url }}" style="color:#3498db;font-size:12px;">查看原微博 →</a></div>
    </div>
    {% endfor %}
    {% else %}
    <p style="color:#2ecc71;text-align:center;padding:18px 0;font-size:15px;">✅ 监测区间内未发现新增的个人负面舆情</p>
    {% endif %}

    <!-- 区县分布 -->
    {% if region_stats %}
    <h3 style="border-left:4px solid #3498db;padding-left:8px;margin:22px 0 10px;font-size:15px;">📍 区县分布</h3>
    <table width="100%" cellpadding="6" cellspacing="0" style="font-size:13px;border-collapse:collapse;">
      <tr style="background:#f8f9fa;color:#666;">
        <th align="left">区县</th><th>总量</th><th>负面</th><th>占比</th>
      </tr>
      {% for r in region_stats %}
      <tr style="border-bottom:1px solid #f0f0f0;">
        <td>{{ r.name }}</td>
        <td align="center">{{ r.total }}</td>
        <td align="center" style="color:{{ r.color }};font-weight:bold;">{{ r.neg }}</td>
        <td align="center">{{ '%.1f'|format(r.ratio) }}%</td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}

    <div style="margin-top:20px;padding-top:12px;border-top:1px solid #eee;color:#aaa;font-size:12px;text-align:center;">
      完整数据见附件 CSV/JSON ｜ 汉中舆情监测 v5
    </div>
  </div>
</div>
</body>
</html>
