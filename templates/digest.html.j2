<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>陕西舆情日报</title>
</head>
<body style="margin:0;background:#f2f4f7;color:#20242c;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f2f4f7;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:720px;background:#ffffff;border:1px solid #e2e5ea;border-radius:8px;overflow:hidden;">
          <tr>
            <td style="background:#272b33;padding:26px 28px;color:#ffffff;">
              <div style="font-size:12px;color:#adb5c2;margin-bottom:8px;">PUBLIC OPINION DAILY</div>
              <div style="font-size:24px;font-weight:700;">陕西舆情日报</div>
              <div style="font-size:13px;color:#cbd1da;margin-top:8px;">监测周期 {{ period }} · 生成于 {{ generated_at }}</div>
            </td>
          </tr>

          <tr>
            <td style="padding:22px 28px;border-bottom:1px solid #e8eaee;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                  <td width="33%" style="padding:8px 0;">
                    <div style="font-size:24px;font-weight:700;color:{% if total_new_neg %}#c9362b{% else %}#16845b{% endif %};">{{ total_new_neg }}</div>
                    <div style="font-size:12px;color:#707783;">新增关注</div>
                  </td>
                  <td width="33%" style="padding:8px 0;border-left:1px solid #e8eaee;text-align:center;">
                    <div style="font-size:24px;font-weight:700;">{{ total_posts }}</div>
                    <div style="font-size:12px;color:#707783;">采集微博</div>
                  </td>
                  <td width="33%" style="padding:8px 0;border-left:1px solid #e8eaee;text-align:right;">
                    <div style="font-size:24px;font-weight:700;color:{% if any_unhealthy %}#c9362b{% else %}#16845b{% endif %};">{{ healthy_count }}/{{ sections|length }}</div>
                    <div style="font-size:12px;color:#707783;">采集健康</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {% if leader_text %}
          <tr>
            <td style="padding:24px 28px;background:#fff8e8;border-bottom:1px solid #f1dfb1;">
              <div style="font-size:17px;font-weight:700;color:#493b18;margin-bottom:6px;">今日推荐候选（{{ recommendation_count }} 条）</div>
              <div style="font-size:12px;color:#7f6a35;margin-bottom:14px;">已按严重度与热度排序，可从中选取需要转发的条目</div>
              <div style="white-space:pre-wrap;word-break:break-word;background:#ffffff;border:1px solid #ead9a8;border-radius:6px;padding:16px;font-size:14px;line-height:1.85;color:#2e3035;">{{ leader_text }}</div>
            </td>
          </tr>
          {% endif %}

          {% for section in sections %}
          <tr>
            <td style="padding:24px 28px;border-bottom:1px solid #e8eaee;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:16px;">
                <tr>
                  <td style="font-size:19px;font-weight:700;">{{ section.city }}舆情</td>
                  <td align="right">
                    <span style="display:inline-block;padding:4px 8px;border-radius:4px;background:{% if section.health_ok %}#eaf7f1{% else %}#fff0ee{% endif %};color:{% if section.health_ok %}#167353{% else %}#b83229{% endif %};font-size:12px;">{% if section.health_ok %}采集正常{% else %}采集异常{% endif %}</span>
                  </td>
                </tr>
              </table>

              <div style="font-size:13px;color:#6f7682;margin-bottom:16px;">新增 {{ section.new_neg }} 条 · 历史命中 {{ section.old_neg }} 条 · 共采集 {{ section.total }} 条 · 过滤官方号 {{ section.filtered }} 条</div>

              {% if section.new_negatives %}
                {% for weibo in section.new_negatives %}
                <div style="border-left:4px solid {{ label_colors.get(weibo.sentiment_label, '#64748b') }};background:#fafbfc;padding:14px 16px;margin:0 0 12px 0;">
                  <div style="margin-bottom:8px;">
                    <b style="color:{{ label_colors.get(weibo.sentiment_label, '#64748b') }};">{{ weibo.sentiment_label }}</b>
                    <span style="color:#7a818d;font-size:12px;"> · 热度 {{ weibo.heat }} · {{ weibo.time }} · {{ weibo.regions|join('、') }}</span>
                  </div>
                  <div style="font-size:14px;line-height:1.7;word-break:break-word;">{{ weibo.text }}</div>
                  <div style="font-size:12px;color:#767d88;margin-top:8px;">@{{ weibo.user }} · <a href="{{ weibo.url }}" style="color:#1769aa;text-decoration:none;">查看原微博</a></div>
                </div>
                {% endfor %}
              {% else %}
                <div style="padding:14px 16px;background:#edf8f3;color:#176d50;font-size:14px;">未发现新增个人负面舆情</div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}

          <tr>
            <td style="padding:18px 28px;background:#f8f9fb;color:#7b828d;font-size:12px;line-height:1.6;">
              本邮件由陕西多市微博舆情监测自动生成。完整数据见随附 CSV / JSON 文件。
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
