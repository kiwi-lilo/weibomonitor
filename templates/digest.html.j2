<!DOCTYPE html>
<html lang="zh-CN">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:'PingFang SC','Microsoft YaHei',sans-serif;">
<div style="max-width:760px;margin:0 auto;padding:16px;">

  <!-- 顶部状态栏 -->
  <div style="background:{{ '#e74c3c' if total_new_neg else '#2ecc71' }};color:#fff;border-radius:8px;padding:18px 20px;margin-bottom:16px;">
    <div style="font-size:20px;font-weight:bold;">陕西多市微博舆情日报</div>
    <div style="font-size:13px;opacity:.9;margin-top:4px;">
      {{ sections|length }} 市 ｜ 新增负面合计 {{ total_new_neg }} 条{% if any_unhealthy %} ｜ ⚠️ 部分城市采集异常{% endif %}
    </div>
    <div style="font-size:12px;opacity:.8;margin-top:4px;">监测区间 {{ period }} ｜ 生成于 {{ generated_at }}</div>
  </div>

  <!-- ✅ 领导舆情专报 (只有在有内容时才显示) -->
  {% if leader_text %}
  <div style="background:#fff3cd;border:1px solid #ffeeba;border-radius:8px;padding:16px 20px;margin-bottom:16px;color:#856404;">
    <div style="font-size:16px;font-weight:bold;margin-bottom:10px;border-bottom:1px solid #ffeeba;padding-bottom:8px;">
      👑 领导舆情专报 (全省 Top 10)
    </div>
    <div style="font-size:15px;line-height:1.8;font-family:sans-serif;">
      <!-- replace 自动将纯文本的换行变成网页里的换行 -->
      {{ leader_text | replace('\n', '<br>') | safe }}
    </div>
  </div>
  {% endif %}

  <!-- 各市汇总表格 -->
  <table width="100%" cellpadding="8" cellspacing="0" style="background:#fff;border-radius:8px;font-size:13px;border-collapse:separate;margin-bottom:16px;">
    <tr style="color:#888;"><th align="left" style="padding-left:16px;">城市</th><th>新增负面</th><th>微博总量</th><th>状态</th></tr>
    {% for s in sections %}
    <tr style="border-top:1px solid #f0f0f0;">
      <td style="padding-left:16px;font-weight:bold;">{{ s.city }}</td>
      <td align="center" style="color:{{ '#e74c3c' if s.new_neg else '#2ecc71' }};font-weight:bold;">{{ s.new_neg }}</td>
      <td align="center">{{ s.total }}</td>
      <td align="center">{{ '正常' if s.health_ok else '⚠️异常' }}</td>
    </tr>
    {% endfor %}
  </table>

  <!-- 各市详情片段 -->
  {% for s in sections %}{{ s.html|safe }}{% endfor %}

  <div style="padding-top:10px;color:#aaa;font-size:12px;text-align:center;">
    各市完整数据见附件 CSV/JSON ｜ 陕西舆情监测 v5
  </div>
</div>
</body>
</html>
