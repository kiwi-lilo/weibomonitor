# 必填：微博登录 Cookie
WEIBO_COOKIE=""

# 邮件日报（保留完整 HTML 报告和 CSV / JSON 附件）
SMTP_SERVER="smtp.qq.com"
SMTP_PORT="465"
EMAIL_SENDER=""
EMAIL_PASSWORD=""
EMAIL_RECEIVERS=""

# 必填：Bark App 中的推送地址，保留到设备 Key 即可
# 官方服务示例：https://api.day.app/your-device-key
# 自建服务示例：https://bark.example.com/your-device-key
BARK_URL=""

# Bark 通知分组和图标（可选）
BARK_GROUP="陕西舆情监测"
BARK_ICON=""

# 企业微信机器人 Webhook（建议放入 GitHub Secret：WECOM_WEBHOOK）
WECOM_WEBHOOK=""

# 联合报告入口地址；GitHub Actions 工作流已默认设置为该固定地址
REPORT_URL=""

# 可选：OpenAI 兼容接口，用于舆情复核与摘要；默认使用 DeepSeek
LLM_API_BASE="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-v4-flash"
# 有配图的微博使用视觉模型读取图中文字和现场证据；留空则始终只读正文
LLM_VISION_MODEL="deepseek-v4-flash-vision-exp"
