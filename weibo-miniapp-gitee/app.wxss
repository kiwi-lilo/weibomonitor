page {
  min-height: 100%;
  color: #28232b;
  background: #f3f5f4;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

